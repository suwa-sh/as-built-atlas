# 本番の設定 (秘密は含めない。パスワード・トークンは実行環境の環境変数で渡す)
KOTORI_DATABASE_URL=postgresql://kotori@db.internal:5432/kotori
KOTORI_CACHE_URL=redis://cache.internal:6379/0
KOTORI_MQ_URL=amqp://kotori@mq.internal:5672/%2F
REPORTS_BUCKET=kotori-reports
EXPORTS_BUCKET=kotori-exports
BACKUPS_BUCKET=kotori-backups
AWS_DEFAULT_REGION=ap-northeast-1
