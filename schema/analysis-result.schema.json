{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suwa-sh/as-built-atlas/schema/analysis-result.schema.json",
  "title": "分析結果 (入口 1 件 = YAML 1 ファイル)",
  "description": "正本。主張 (claim) ごとに 状態 (fact / interpretation / unknown) と根拠を持つ。コールスタックの各段はプロファイルの層を名乗る。機械チェック (abatlas validate) はこの schema に加えて、層がプロファイルにあるか、呼び出し元の参照が解決するか、根拠のファイルが scope にあるかを検査する。",
  "type": "object",
  "required": [
    "format_version",
    "entry",
    "target",
    "analyzer",
    "summary",
    "callstack"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "path",
        "layer",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^/]+(/[^/]+)*$"
        },
        "name": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "target": {
      "$ref": "work-definition.schema.json#/$defs/target"
    },
    "analyzer": {
      "type": "object",
      "description": "どの分析器で作ったか。target.commit と合わせて冪等の判定に使う",
      "required": [
        "profile",
        "skill_version",
        "analyzed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "skill_version": {
          "type": "string",
          "description": "分析 skill (OSS 層) の版"
        },
        "model": {
          "type": "string",
          "description": "使ったモデルの識別 (任意)"
        },
        "analyzed_at": {
          "type": "string",
          "format": "date-time"
        },
        "analyst": {
          "type": "string",
          "description": "誰が回したか (任意。進行状況 mart の人別集計用)"
        },
        "reviewed": {
          "type": "object",
          "description": "フレッシュ文脈のレビューの結果 (任意)",
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "findings_open": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "run": {
          "type": "object",
          "description": "実行の記録 (任意)。分析 skill は書かない。claude -p などを呼んだ側が終了後に書く (実行中のセッションは自身のコストを知れない)",
          "additionalProperties": false,
          "properties": {
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "duration_s": {
              "type": "number",
              "minimum": 0
            },
            "by": {
              "type": "string",
              "description": "書いた主体 (runner の名前など)"
            }
          }
        },
        "tests": {
          "type": "boolean",
          "description": "テストとの対応 (callstack[].tests) を分析したか。作業定義の analysis.tests が true のときに、分析 skill が true を書く。無い・false の結果では、tests が空でも「テストが無い」とは言えない"
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/text_claim",
      "description": "入口の概要 (解釈)"
    },
    "callstack": {
      "type": "array",
      "description": "入口から外部ライブラリ呼び出し (boundary 層) までのフレーム。順序は呼び出し順でなくてよい。関係は caller で表す",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "notes": {
      "type": "string",
      "description": "分析者の自由記述 (正本の項目にはしない)"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "target.scope からの相対パス"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claim_base": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fact",
            "interpretation",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reason": {
          "type": "string",
          "description": "status: unknown のときの理由。schema/vocab/unknown-reasons.yaml の key"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fact"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "interpretation"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "text_claim": {
      "description": "文字列の値を持つ主張。unknown のときは value を省く",
      "allOf": [
        {
          "$ref": "#/$defs/claim_base"
        },
        {
          "properties": {
            "value": {
              "type": "string"
            },
            "status": true,
            "evidence": true,
            "reason": true,
            "note": true
          },
          "additionalProperties": false
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "name",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "この YAML の中で一意"
        },
        "layer": {
          "type": "string",
          "description": "プロファイルの層 id"
        },
        "kind": {
          "type": "string",
          "description": "フレームの種類 (script / program / skill / library / service など。プロファイルの context.md で揃える)"
        },
        "name": {
          "type": "string",
          "description": "人が読む名前 (スクリプト名、関数名、skill 名)"
        },
        "source": {
          "$ref": "#/$defs/source",
          "description": "このフレームの定義場所。unknown のフレームは呼び出し箇所を指す。boundary 層のフレーム (リポジトリに定義が無いライブラリ・SDK・CLI) は、リポジトリの中でそれを使っている箇所を指す (どの行にするかはプロファイルの context.md の決まりに従う)"
        },
        "caller": {
          "type": [
            "string",
            "null"
          ],
          "description": "呼び出し元フレームの id。入口のフレームは null"
        },
        "call": {
          "$ref": "#/$defs/call_claim",
          "description": "caller からこのフレームへの呼び出しが成立していることの主張 (事実なら呼び出し箇所が根拠)"
        },
        "summary": {
          "$ref": "#/$defs/text_claim"
        },
        "parameters": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "description": "分かる範囲の値や由来"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "io": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/io"
          }
        },
        "links": {
          "type": "array",
          "description": "この段から、ほかの入口へのつながり (画面の遷移、ジョブや処理の起動、小窓で重ねる画面)。同じリポジトリの中の関数呼び出しは caller で表し、ここには書かない。外部の API の呼び出しは io (external_api) に書く",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "kind",
                  "target"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "navigate",
                      "trigger",
                      "overlay",
                      "embed"
                    ],
                    "description": "navigate = 画面の遷移、trigger = 別の入口 (ジョブ、フロー、処理) の起動、overlay = いまの画面に重ねて開く画面、embed = この入口の中に描く、別の入口にした部品 (プロファイルが、部品を別の入口に分けると決めているときだけ)"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "description": "行き先。コードに書いてあるとおりに書く (ルートの名前、URL の形、フローの id など)"
                  },
                  "entry_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "行き先が入口の一覧のどれかを特定できたときの、入口の id。特定できなければ書かない (集計が target と突き合わせる)"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "guards": {
          "type": "array",
          "description": "この段で行う、権限の確認 (満たさなければ先へ進めない確認)。役割・権限・持ち主の確認は、unknown でなければ value を必ず書く",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "authentication",
                      "role",
                      "permission",
                      "ownership",
                      "other"
                    ],
                    "description": "authentication = ログイン済みか、role = 役割、permission = 権限 (操作の許可)、ownership = 持ち主・所属か、other = そのほか"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "求める値 (役割や権限の名前、持ち主の条件)。コードに書いてあるとおりに書く"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "fact",
                        "interpretation"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "role",
                        "permission",
                        "ownership"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          }
        },
        "settings": {
          "type": "array",
          "description": "この段の動きを変える設定 (環境変数、機能の切り替え、設定ファイルの値)。unknown でなければ、effect を必ず書く",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "設定の名前 (環境変数の名前、切り替えのキー)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "env",
                      "feature_flag",
                      "config_file",
                      "remote",
                      "other"
                    ],
                    "description": "設定の種類。env = 環境変数、feature_flag = 機能の切り替え、config_file = 設定ファイルの値、remote = 実行時に外から取る設定"
                  },
                  "effect": {
                    "type": "string",
                    "minLength": 1,
                    "description": "この設定で、動きがどう変わるか"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "fact",
                        "interpretation"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "effect"
                  ]
                }
              }
            ]
          }
        },
        "rules": {
          "type": "array",
          "description": "この段にある業務のルール (計算式、入力の検証、判定の条件)。根拠は、式や条件の行。unknown でなければ、value を必ず書く",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "calculation",
                      "validation",
                      "decision"
                    ],
                    "description": "calculation = 計算、validation = 入力や状態の検証、decision = 処理を分ける判定"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "ルールの内容 (1 文)。unknown のときは省く"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "fact",
                        "interpretation"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          }
        },
        "tests": {
          "type": "array",
          "description": "この段 (関数やスクリプト) を直接呼ぶテスト。根拠は、テストの行。作業定義の analysis.tests が true のときだけ書く",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/claim_base"
              },
              {
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "テストの名前 (関数名、ケース名)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "unit",
                      "integration",
                      "e2e"
                    ],
                    "description": "unit = 単体、integration = 結合、e2e = 画面や入口を通す"
                  },
                  "status": true,
                  "evidence": true,
                  "reason": true,
                  "note": true
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "io": {
      "allOf": [
        {
          "$ref": "#/$defs/claim_base"
        },
        {
          "required": [
            "op",
            "resource"
          ],
          "properties": {
            "op": {
              "type": "string",
              "minLength": 1,
              "description": "操作。resource.kind ごとに使える id が決まっている (schema/vocab/resource-kinds.yaml の kinds.<kind>.ops[].id。例: rdb は create / read / update / delete、filesystem は read / write / append / delete / list、external_api は call)。機械チェックと ETL が種類と突き合わせる"
            },
            "resource": {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "schema/vocab/resource-kinds.yaml の kind"
                },
                "levels": {
                  "type": "object",
                  "description": "データの階層の段 → 値。段の名前は resource-kinds.yaml に従う。分からない段は書かない (理由は親の reason)",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "detail": {
              "type": "string",
              "description": "列・キー・メソッドなど、段より細かい情報"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "description": "この読み書きが触る列 (RDB の列、KVS やファイルの中の項目、外部 API の項目)。分からなければ書かない。全部の列を触るときは name に * を書く",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "use"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "列の名前。データの側の名前で書く (ORM の属性名ではなく、分かるなら実際の列名)。全部の列は *"
                  },
                  "use": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "read",
                        "write",
                        "filter"
                      ]
                    },
                    "description": "使い方。read = 値を読む、write = 値を書く、filter = 絞り込み・結合・並べ替えの条件に使う"
                  },
                  "set_to": {
                    "type": "string",
                    "minLength": 1,
                    "description": "書く値が決まっているときの値 (状態の列に書く値など)。use に write があるときだけ書ける"
                  }
                }
              }
            },
            "status": true,
            "evidence": true,
            "reason": true,
            "note": true
          },
          "additionalProperties": false
        }
      ]
    },
    "call_claim": {
      "description": "呼び出しが成立していることの主張。when は、その呼び出しがいつ起きるか",
      "allOf": [
        {
          "$ref": "#/$defs/claim_base"
        },
        {
          "properties": {
            "when": {
              "type": "string",
              "enum": [
                "always",
                "conditional",
                "on_failure"
              ],
              "description": "always = 呼び出し元が動けば必ず呼ぶ、conditional = 条件を満たすときだけ呼ぶ、on_failure = 呼び出し元の処理が失敗したときだけ呼ぶ (例外の処理、失敗の通知、後片付け、やり直し)。無いときは、分析していない"
            },
            "condition": {
              "type": "string",
              "minLength": 1,
              "description": "conditional と on_failure のときの条件 (1 文)。always のときは書かない"
            },
            "status": true,
            "evidence": true,
            "reason": true,
            "note": true
          },
          "additionalProperties": false
        },
        {
          "if": {
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "enum": [
                  "conditional",
                  "on_failure"
                ]
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        },
        {
          "if": {
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "const": "always"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "condition"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "condition"
            ]
          },
          "then": {
            "required": [
              "when"
            ]
          }
        }
      ]
    }
  }
}
