{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suwa-sh/as-built-atlas/schema/batch-draft.schema.json",
  "title": "全体承認のための下書き",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment"],
  "properties": {
    "assessment": {
      "type": "string",
      "pattern": "\\S"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries", "action", "reason"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "action": {
            "enum": ["include", "exclude", "reanalyze"]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries", "question"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "question": {
            "type": "string",
            "pattern": "\\S"
          },
          "answer": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
