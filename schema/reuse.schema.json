{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suwa-sh/as-built-atlas/schema/reuse.schema.json",
  "title": "入口の再利用の確認記録",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "entry_id",
    "repo",
    "scope",
    "reason",
    "confirmed_by",
    "analyzed_commit",
    "effective_commit",
    "baseline",
    "conditions_digest",
    "result_digest"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    },
    "analyzed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "effective_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "conditions_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
